FROM python:3.13-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive \
    QT_QPA_PLATFORM=offscreen \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils file ca-certificates fontconfig fonts-dejavu-core fonts-noto-cjk \
    libgl1 libegl1 libopengl0 libglib2.0-0t64 libdbus-1-3 libxkbcommon0 libxkbcommon-x11-0 \
    libxcb1 libx11-xcb1 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
    libxcb-image0 libxcb-render-util0 libxcb-shape0 libxcb-randr0 \
    libxcb-xfixes0 libxcb-sync1 libxcb-xinerama0 libxcb-util1 libxcb-xkb1 \
    libxcb-glx0 && rm -rf /var/lib/apt/lists/*

COPY linux-entrypoint.sh /usr/local/bin/opennavicat-linux-build
RUN chmod 755 /usr/local/bin/opennavicat-linux-build
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/opennavicat-linux-build"]
